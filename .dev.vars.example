# Copy to .dev.vars for local development. Never commit the real file.
# Every secret below is optional: the product reports an honest unavailable
# state instead of pretending a provider exists.

# Signs sessions and encrypts third-party tokens at rest. Required in production.
SESSION_SECRET=

# Conversational model. Falls back to Workers AI when absent.
DEEPSEEK_API_KEY=

# Transcription fallback when Workers AI is not bound.
OPENAI_API_KEY=

# Web search. Falls back to a keyless HTML endpoint when absent.
BRAVE_SEARCH_KEY=

# Social login. Each provider is independently optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare resource authorisation, separate from application login.
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=

# fal.ai, for image generation and other hosted compute. Without it, image
# generation falls back to the bound Workers AI model.
FAL_KEY=

# Scoped to Browser Rendering: Edit only. Screenshots are unavailable without
# it. The deploy token is deliberately not reused: a rendering credential
# should only be able to render.
BROWSER_RENDERING_TOKEN=

# Comma-separated addresses granted the super-admin role on first sign-in.
# Kept as a secret rather than a var so no address is committed to the repo.
SUPER_ADMIN_EMAILS=

# For local development only. Setting this to false disables the Access gate,
# which is why it lives here and not in wrangler.jsonc.
# ACCESS_REQUIRED=false
