{
  "name": "anascummis-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "backend": "bun core/server.ts",
    "build": "bun scripts/build-scene.ts && next build --webpack && bun run kit:build",
    "start": "bun scripts/dev.ts --production",
    "test": "bun scripts/test.ts",
    "test:research:edge": "bun scripts/test-research-edge.ts",
    "test:download:ui": "bun build scripts/test-download-ui.ts --target=node --external playwright-core --outfile=.test-data/download-ui.mjs && node .test-data/download-ui.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "bun scripts/setup.ts",
    "speech:setup": "bun scripts/speech-setup.ts",
    "model:setup": "bun scripts/model.ts setup",
    "model:start": "bun scripts/model.ts start",
    "demo:build": "bun run build && bun scripts/prepare-demo.ts",
    "demo:deploy": "wrangler deploy --config wrangler.demo.jsonc",
    "kit:build": "bun scripts/publish-sources.ts",
    "test:e2e": "node scripts/test-user-journeys.mjs",
    "test:e2e:research-document": "node scripts/e2e/research-document.mjs",
    "test:e2e:research-document-edit": "node scripts/e2e/research-document-edit.mjs",
    "test:e2e:research-document-second-edit": "node scripts/e2e/research-document-second-edit.mjs",
    "test:local-ai": "bun scripts/check-local-ai.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.14.0",
    "@huggingface/transformers": "^4.0.0",
    "etro": "0.14.1",
    "flexlayout-react": "^0.11.1",
    "kokoro-js": "1.2.1",
    "next": "16.4.3",
    "playwright-core": "^1.64.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.7.2",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "@huggingface/transformers": "4.3.1",
    "sharp": "0.35.5"
  }
}
