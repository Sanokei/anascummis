{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anascummis",
  "main": "src/worker/index.ts",
  // Held at the date the pinned test runtime supports. The installed
  // miniflare caps here, so a later date would mean tests and production
  // exercised different runtime behaviour while appearing to agree.
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  // Fengari eagerly loads every Lua standard library, so importing it drags in
  // `tmp` (for os.tmpname) and `readline-sync` (for debug.debug). Both call
  // process.binding, which workerd does not implement. The sandbox removes
  // `os` and `debug` anyway, so these stubs only have to satisfy the imports.
  "alias": {
    "tmp": "./src/worker/lua/tmp-stub.ts",
    "readline-sync": "./src/worker/lua/readline-stub.ts"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "anascummis.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything runs the Worker first so the Access gate is authoritative.
    // With a path list here, static assets were served straight from the
    // binding and the in-Worker gate never saw them: if the edge Access policy
    // were ever removed, the client shell would have been public.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anascummis-db",
      "database_id": "6c041ed8-d93c-4156-afd9-cebb8da88f9a",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "2716ed1f396447f19583bd0f0b710888" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionCoordinator"] }
  ],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "VISION", "bucket_name": "anascummis-vision" }
  ],
  "vars": {
    "APP_NAME": "Anascummis",
    "APP_URL": "https://anascummis.com",
    "ACCESS_REQUIRED": "true",
    "ACCESS_ALLOWED_DOMAINS": "",
    // Not secrets: the team domain is public and the audience tag identifies
    // the application without authorising anything on its own.
    "CF_ACCESS_TEAM_DOMAIN": "kinoinstrument.cloudflareaccess.com",
    "CF_ACCESS_AUD": "6ef46bd749c532b9237f201b49d1068e8ef6ee376afee20497e4d3cbd6768d41",
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com/v1",
    "DEEPSEEK_MODEL": "deepseek-flash",
    "DEEPSEEK_MODEL_PRO": "deepseek-reasoner",
    "DEEPSEEK_MODEL_VISION": "deepseek-flash",
    "WORKERS_AI_CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "WORKERS_AI_TRANSCRIBE_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "WORKERS_AI_IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
    "FAL_IMAGE_MODEL": "fal-ai/flux/schnell",
    "CLOUDFLARE_ACCOUNT_ID": "0355a48bdcf68a5e308d3eb51082eafe",
    "GUEST_RETENTION_SECONDS": "86400",
    "MAX_STORY_DISPATCHES_PER_TURN": "3",
    "MAX_FORGE_ATTEMPTS": "3"
  }
}
